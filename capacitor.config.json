{
  "appId": "br.com.hae.auditoria.teste",
  "appName": "IDAuditor",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#f7fafc",
      "showSpinner": false
    },
    "LiveUpdate": {
      "readyTimeout": 15000,
      "autoBlockRolledBackBundles": true,
      "autoDeleteBundles": true,
      "autoUpdateStrategy": "none"
    }
  }
}
